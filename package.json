{
  "name": "minisitee.com",
  "private": true,
  "description": "Landing estática do minisitee. O Tailwind só gera o CSS; o site continua HTML puro.",
  "scripts": {
    "css": "tailwindcss -i src/site.css -o assets/site.css --minify",
    "css:watch": "tailwindcss -i src/site.css -o assets/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
